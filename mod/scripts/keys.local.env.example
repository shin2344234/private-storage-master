# Copy this file to keys.local.env in the same folder and paste your keys in.
# keys.local.env is gitignored. This example file is not, and holds no key.
# The same three keys work in every mod.
#
# Nexus Mods:  https://www.nexusmods.com/settings/api-keys
#              Scroll past the app keys to "Personal API Key" and generate one.
# VirusTotal:  sign in at virustotal.com, account menu (top right), API key.
#              The free key is enough: 500 requests a day, six per release.
# Discord:     the bot's token, from the Developer Portal. announce-discord.py
#              posts the release to #mod-releases as the bot with it.
#
# No script ever prints a key, and none writes one anywhere.

NEXUS_API_KEY=
VT_API_KEY=
DISCORD_BOT_TOKEN=

# Optional. The channel id is in release.json, since it is not a secret.
# DISCORD_RELEASES_CHANNEL=
